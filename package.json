{
  "name": "@sandsoftwaresolutions/openapi-fixtures",
  "version": "0.1.0",
  "description": "Generate realistic, reproducible API fixtures from OpenAPI and Swagger schemas.",
  "type": "module",
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.js" } },
  "files": ["src", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": { "test": "node --test", "pack:check": "npm pack --dry-run" },
  "keywords": ["openapi", "swagger", "faker", "fixtures", "mock", "api-testing"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/SandSoftwareSolutions/ss-openapi-fixtures.git" },
  "publishConfig": { "access": "public" },
  "dependencies": { "@faker-js/faker": "^10.6.0" }
}
